{% extends "cabinet.html.j2" %}{% block title %}Справочники{% endblock %}{% block heading %}Справочники{% endblock %}
{% block content %}<p class="note">Ключи не меняются: они часть постоянных адресов. Названия и определения правятся; новые разделы, практики и типы добавляются. Роли задают правило сигнала, поэтому новая роль появляется только через «Правила атласа».</p>
<div class="panel"><h3>Разделы · {{ sections | length }}</h3>{% for s in sections %}<form method="post" action="{{ prefix }}/refs" class="toolbar" style="border-bottom:1px solid var(--line);padding-bottom:8px"><input type="hidden" name="csrf" value="{{ user.csrf }}"><input type="hidden" name="kind" value="sections"><input type="hidden" name="key" value="{{ s.key }}">
<span class="sid" style="min-width:90px">{{ s.key }} · {{ s.n }}</span><input name="short" value="{{ s.short }}" aria-label="Короткое название"><input name="name" value="{{ s.name }}" aria-label="Название" style="min-width:260px"><input name="definition" value="{{ s.definition }}" aria-label="Определение" style="flex:1;min-width:260px"><button class="btn small" type="submit">Сохранить</button></form>{% endfor %}
<form method="post" action="{{ prefix }}/refs" class="toolbar"><input type="hidden" name="csrf" value="{{ user.csrf }}"><input type="hidden" name="kind" value="sections"><input type="hidden" name="action" value="add"><input name="key" placeholder="ключ латиницей" required aria-label="Ключ"><input name="short" placeholder="короткое название" required aria-label="Короткое название"><input name="name" placeholder="название" required aria-label="Название"><input name="definition" placeholder="что в него попадает" aria-label="Определение"><button class="btn" type="submit">Добавить раздел</button></form></div>
<div class="panel"><h3>Практики контроля · {{ practices | length }}</h3>{% for p in practices %}<form method="post" action="{{ prefix }}/refs" class="toolbar" style="border-bottom:1px solid var(--line);padding-bottom:8px"><input type="hidden" name="csrf" value="{{ user.csrf }}"><input type="hidden" name="kind" value="practices"><input type="hidden" name="key" value="{{ p.key }}">
<span class="sid" style="min-width:160px">{{ p.key }} · {{ p.n }}</span><input name="name" value="{{ p.name }}" aria-label="Название" style="min-width:300px"><button class="btn small" type="submit">Сохранить</button></form>{% endfor %}
<form method="post" action="{{ prefix }}/refs" class="toolbar"><input type="hidden" name="csrf" value="{{ user.csrf }}"><input type="hidden" name="kind" value="practices"><input type="hidden" name="action" value="add"><input name="key" placeholder="ключ латиницей" required aria-label="Ключ"><input name="name" placeholder="название" required aria-label="Название"><button class="btn" type="submit">Добавить практику</button></form></div>
<div class="panel"><h3>Типы материалов · {{ types | length }}</h3><div class="chips">{% for ty in types %}<span class="chip">{{ ty.name }} <em>{{ ty.n }}</em></span>{% endfor %}</div>
<form method="post" action="{{ prefix }}/refs" class="toolbar"><input type="hidden" name="csrf" value="{{ user.csrf }}"><input type="hidden" name="kind" value="types"><input type="hidden" name="action" value="add"><input name="name" placeholder="новый тип" required aria-label="Тип"><button class="btn" type="submit">Добавить тип</button></form></div>
<div class="panel"><h3>Роли материалов · {{ roles | length }}</h3><table class="tbl"><tr><th>Роль</th><th>Оценка</th><th>Для сигнала</th><th>Связей</th></tr>{% for r in roles %}<tr><td>{{ r.name }}</td><td>{{ r.default_grade }}</td><td>{{ 'может учитываться' if r.may_count else 'нет' }}</td><td class="sid">{{ r.n }}</td></tr>{% endfor %}</table></div>
{% endblock %}
