{% extends "cabinet.html.j2" %}{% block title %}Лента изменений{% endblock %}{% block heading %}Лента изменений{% endblock %}
{% block content %}
{% for v in versions %}{% set ch = v.changes if v.changes is mapping else {} %}{% set sharp = (v.checks or []) | selectattr('id', 'equalto', 'sharp_changes') | list %}
<div class="panel"><h3>Версия {{ v.id }} · {{ v.title }} <span class="tag{{ ' ok' if v.state == 'current' }}">{{ states[v.state] }}</span></h3>
<p class="note">{{ ch.summary or 'первая версия архива, ручная разметка' }}{% if sharp and sharp[0].held %} · задержана: {{ sharp[0].detail }}{% endif %}</p>
{% if ch.signals %}<ul class="feed">{% for s in ch.signals %}<li><span class="mk"></span><div><div class="what">{{ s.item }}: {{ signals[s.from] }} → {{ signals[s.to] }}</div><div class="why">{{ s.material }}{% if s.quote %} — «{{ s.quote }}»{% endif %}</div></div></li>{% endfor %}</ul>{% endif %}
{% if ch.materials %}<p class="note">Новые материалы: {% for m in ch.materials %}{{ m.section }} +{{ m.n }}{{ ', ' if not loop.last }}{% endfor %}</p>{% endif %}
{% set slinks = (ch.links or []) | selectattr('material', 'defined') | list %}{% if slinks %}<details><summary class="note">Новые связи · {{ slinks | length }}</summary><ul class="feed">{% for l in slinks %}<li><span class="mk"></span><div><div class="what"><a href="{{ prefix }}/material?id={{ l.material }}">{{ l.text }}</a></div></div>
<div class="acts">{% for act, label in [('accept', 'Принято'), ('pin', 'Закрепить')] %}<form method="post" action="{{ prefix }}/link/{{ l.material }}/{{ l.item }}/{{ act }}"><input type="hidden" name="csrf" value="{{ user.csrf }}"><input type="hidden" name="back" value="{{ prefix }}/feed"><button class="btn small" type="submit">{{ label }}</button></form>{% endfor %}
<a class="btn small" href="{{ prefix }}/material?id={{ l.material }}">Исправить</a>
<form method="post" action="{{ prefix }}/link/{{ l.material }}/{{ l.item }}/remove"><input type="hidden" name="csrf" value="{{ user.csrf }}"><input type="hidden" name="back" value="{{ prefix }}/feed"><input type="hidden" name="reason" value="отменено в ленте изменений"><button class="btn small danger" type="submit">Отменить</button></form></div></li>{% endfor %}</ul></details>{% endif %}
{% if ch.editorial %}<p class="note">Уточнения редакции: {% for e in ch.editorial %}{{ e.text }} {% endfor %}</p>{% endif %}
<div class="toolbar">{% if v.state == 'held' %}<form method="post" action="{{ prefix }}/publish/{{ v.id }}" data-confirm="Опубликовать версию {{ v.id }}? Она станет текущей на сайте."><input type="hidden" name="csrf" value="{{ user.csrf }}">{% if sharp and sharp[0].held %}<input type="hidden" name="force_sharp" value="1">{% endif %}<button class="btn primary" type="submit">Опубликовать</button></form>{% endif %}
{% if v.state == 'published' %}<form method="post" action="{{ prefix }}/rollback/{{ v.id }}" class="toolbar" style="margin:0" data-confirm="Откатить сайт и данные на версию {{ v.id }}?"><input type="hidden" name="csrf" value="{{ user.csrf }}"><label class="field" style="margin:0;min-width:260px"><span>Причина отката</span><input name="reason" required></label><button class="btn danger" type="submit">Откатить сайт на эту версию</button></form>{% endif %}
<a class="btn small" href="/versions/{{ v.id }}/" target="_blank" rel="noopener">Что изменилось</a></div></div>{% endfor %}{% endblock %}
