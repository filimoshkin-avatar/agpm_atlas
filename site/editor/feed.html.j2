{% extends "cabinet.html.j2" %}{% block title %}Лента изменений{% endblock %}{% block heading %}Лента изменений{% endblock %}
{% block content %}{% if message %}<div class="panel" role="status"><b>{{ message }}</b></div>{% endif %}
{% for v in versions %}{% set ch = v.changes if v.changes is mapping else {} %}{% set sharp = (v.checks or []) | selectattr('id', 'equalto', 'sharp_changes') | list %}
<div class="panel"><h3>Версия {{ v.id }} · {{ v.title }} <span class="tag{{ ' ok' if v.state == 'current' }}">{{ states[v.state] }}</span></h3>
<p class="note">{{ ch.summary or 'первая версия архива, ручная разметка' }}{% if sharp and sharp[0].held %} · задержана: {{ sharp[0].detail }}{% endif %}</p>
{% if ch.signals %}<ul class="feed">{% for s in ch.signals %}<li><div><div class="what">{{ s.item }}: {{ signals[s.from] }} → {{ signals[s.to] }}</div><div class="why">{{ s.material }}{% if s.quote %} — «{{ s.quote }}»{% endif %}</div></div></li>{% endfor %}</ul>{% endif %}
{% if ch.materials %}<p class="note">Новые материалы: {% for m in ch.materials %}{{ m.section }} +{{ m.n }}{{ ', ' if not loop.last }}{% endfor %}</p>{% endif %}
{% if ch.editorial %}<p class="note">Уточнения редакции: {% for e in ch.editorial %}{{ e.text }} {% endfor %}</p>{% endif %}
<div class="toolbar">{% if v.state == 'held' %}<form method="post" action="{{ prefix }}/publish/{{ v.id }}"><input type="hidden" name="csrf" value="{{ user.csrf }}">{% if sharp and sharp[0].held %}<input type="hidden" name="force_sharp" value="1">{% endif %}<button class="btn primary" type="submit">Опубликовать</button></form>{% endif %}
{% if v.state == 'published' %}<form method="post" action="{{ prefix }}/rollback/{{ v.id }}" class="toolbar" style="margin:0"><input type="hidden" name="csrf" value="{{ user.csrf }}"><label class="field" style="margin:0;min-width:260px"><span>Причина отката</span><input name="reason" required></label><button class="btn danger" type="submit">Откатить сайт на эту версию</button></form>{% endif %}
<a class="btn small" href="/versions/{{ v.id }}/" target="_blank" rel="noopener">Что изменилось</a></div></div>{% endfor %}{% endblock %}
