{% extends "base.html.j2" %}
{% block body %}<div class="col"><p class="kicker">Кабинет редактора</p><h1 class="title" style="font-size:32px">{% block heading %}{% endblock %}</h1></div>
<div class="cab col" style="margin-top:18px"><aside class="side"><div class="who"><b>{{ user.name }}</b>
<form method="post" action="{{ prefix }}/logout" style="display:inline"><input type="hidden" name="csrf" value="{{ user.csrf }}"><button class="btn small" type="submit">выйти</button></form></div>
<a href="{{ prefix }}/feed" class="{{ 'on' if active == 'feed' }}">Лента изменений<em>{{ counts.versions }}</em></a>
<a href="{{ prefix }}/queue" class="{{ 'on' if active == 'queue' }}">Очередь на внимание<em>{{ counts.queue }}</em></a>
<a href="{{ prefix }}/material" class="{{ 'on' if active == 'material' }}">Материалы<em>{{ counts.materials }}</em></a>
<a href="{{ prefix }}/scenario" class="{{ 'on' if active == 'scenario' }}">Сценарии<em>{{ counts.scenarios }}</em></a>
<a href="{{ prefix }}/versions" class="{{ 'on' if active == 'versions' }}">Версии{% if counts.pending %}<em>правок {{ counts.pending }}</em>{% else %}<em>{{ counts.versions }}</em>{% endif %}</a>
<a href="{{ prefix }}/sheet" class="{{ 'on' if active == 'sheet' }}">Тексты листа</a>
<a href="{{ prefix }}/refs" class="{{ 'on' if active == 'refs' }}">Справочники</a>
<a href="{{ prefix }}/runs" class="{{ 'on' if active == 'runs' }}">Прогоны</a>
{% if user.role == 'admin' %}<a href="{{ prefix }}/settings" class="{{ 'on' if active == 'settings' }}">Настройки</a>{% endif %}
<a href="/" target="_blank" rel="noopener">Открыть сайт</a></aside><div>{% if message %}<div class="panel" role="status"><b>{{ message }}</b></div>{% endif %}{% block content %}{% endblock %}</div></div>{% endblock %}
