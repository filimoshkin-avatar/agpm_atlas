{% extends "cabinet.html.j2" %}{% block title %}Настройки{% endblock %}{% block heading %}Настройки{% endblock %}
{% block content %}{% if shown_password %}<div class="panel" role="alert"><h3>Пароль для {{ shown_for }}</h3><p><code style="font-size:18px">{{ shown_password }}</code></p><p class="note">Показан один раз; в базе только хеш argon2.</p></div>{% endif %}
<div class="panel"><h3>Предохранители и расходы</h3>{% for s in rows %}<form method="post" action="{{ prefix }}/settings" class="toolbar"><input type="hidden" name="csrf" value="{{ user.csrf }}"><input type="hidden" name="action" value="setting"><input type="hidden" name="key" value="{{ s.key }}">
<label class="field" style="margin:0;flex:1;min-width:280px"><span>{{ s.label }}</span><input name="value" value="{{ s.value }}"{{ '' if s.key in numeric else ' readonly' }}></label>{% if s.key in numeric %}<button class="btn small" type="submit">Сохранить</button>{% endif %}<span class="note">изменено {{ s.updated_at | ru_date }}, {{ s.updated_by }}</span></form>{% endfor %}</div>
<div class="panel"><h3>Учётные записи</h3><table class="tbl"><tr><th>Почта</th><th>Имя</th><th>Роль</th><th></th></tr>{% for e in editors %}<tr><td>{{ e.email }}</td><td>{{ e.name }}</td><td>{{ 'администратор' if e.role == 'admin' else 'редактор' }}{% if e.disabled %} · отключена{% endif %}</td>
<td class="toolbar" style="margin:0"><form method="post" action="{{ prefix }}/settings"><input type="hidden" name="csrf" value="{{ user.csrf }}"><input type="hidden" name="action" value="reset"><input type="hidden" name="id" value="{{ e.id }}"><button class="btn small" type="submit">Новый пароль</button></form>
{% if e.id != user.id %}<form method="post" action="{{ prefix }}/settings"><input type="hidden" name="csrf" value="{{ user.csrf }}"><input type="hidden" name="action" value="toggle"><input type="hidden" name="id" value="{{ e.id }}"><button class="btn small{{ '' if e.disabled else ' danger' }}" type="submit">{{ 'Включить' if e.disabled else 'Отключить' }}</button></form>{% endif %}</td></tr>{% endfor %}</table>
<form method="post" action="{{ prefix }}/settings" class="toolbar"><input type="hidden" name="csrf" value="{{ user.csrf }}"><input type="hidden" name="action" value="add"><input name="email" type="email" placeholder="почта" required aria-label="Почта"><input name="name" placeholder="имя" required aria-label="Имя"><select name="role" aria-label="Роль"><option value="editor">редактор</option><option value="admin">администратор</option></select><button class="btn" type="submit">Добавить редактора</button></form></div>{% endblock %}
